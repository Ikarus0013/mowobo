# Copy this file to .env.local and fill in your own key.
# Never commit the .env.local file.

# Google Gemini API key (required). The server API routes use it.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Public URL of the app (optional). The current code does not read this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000
